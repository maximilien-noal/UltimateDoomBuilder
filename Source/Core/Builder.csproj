<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CodeImp.DoomBuilder</RootNamespace>
    <AssemblyName>Builder</AssemblyName>
    <StartupObject>CodeImp.DoomBuilder.General</StartupObject>
    <ApplicationIcon>Resources\UDB2.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputPath>..\..\Build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Exclude files that were not compiled in the original .NET Framework project.
       ScintillaControl.cs and ScintillaConstants.cs are custom wrappers that were excluded
       from compilation - the project uses ScintillaNET.dll directly instead. -->
  <ItemGroup>
    <Compile Remove="Controls\ScintillaControl.cs" />
    <Compile Remove="Controls\ScintillaConstants.cs" />
    <Compile Remove="Windows\FlatBrowserForm.cs" />
    <Compile Remove="Windows\FlatBrowserForm.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="System.Management" />
    <!-- Local DLL references for Windows-only controls (will be replaced by Avalonia equivalents in Phase 3) -->
    <Reference Include="ScintillaNET">
      <HintPath>..\..\Assets\Common\ScintillaNET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TabControlEX">
      <HintPath>..\..\Assets\Common\TabControlEX.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Embedded resources: shaders, configs, and special images that were explicitly embedded -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\display2d.shader" />
    <EmbeddedResource Include="Resources\things2d.shader" />
    <EmbeddedResource Include="Resources\world3d.shader" />
    <EmbeddedResource Include="Resources\world3d_skybox.shader" />
    <EmbeddedResource Include="Resources\Actions.cfg" />
    <EmbeddedResource Include="Resources\Lexers.cfg" />
    <EmbeddedResource Include="Resources\UDMF.cfg" />
    <EmbeddedResource Include="Resources\ThingTexture2D.png" />
    <EmbeddedResource Include="Resources\MissingTexture3D.png" />
    <EmbeddedResource Include="Resources\MissingSky3D.png" />
    <EmbeddedResource Include="Resources\UnknownTexture3D.png" />
    <EmbeddedResource Include="Resources\MissingThing.png" />
    <EmbeddedResource Include="Resources\UnknownThing.png" />
    <EmbeddedResource Include="Resources\Nothing.png" />
    <EmbeddedResource Include="Resources\Black.png" />
    <EmbeddedResource Include="Resources\White.png" />
    <EmbeddedResource Include="Resources\Crosshair.png" />
    <EmbeddedResource Include="Resources\CrosshairBusy.png" />
    <EmbeddedResource Include="Resources\Hourglass3D.png" />
    <EmbeddedResource Include="Resources\Folder96.png" />
    <EmbeddedResource Include="Resources\Folder96Up.png" />
    <EmbeddedResource Include="Resources\CommentInfo.png" />
    <EmbeddedResource Include="Resources\CommentProblem.png" />
    <EmbeddedResource Include="Resources\CommentQuestion.png" />
    <EmbeddedResource Include="Resources\CommentRegular.png" />
    <EmbeddedResource Include="Resources\CommentSmile.png" />
    <EmbeddedResource Include="Resources\SkySphere.md3" />
  </ItemGroup>

  <!-- Asset files for copying to build output -->
  <PropertyGroup>
    <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
    <IsLinux Condition="'$(OS)' != 'Windows_NT'">true</IsLinux>
  </PropertyGroup>

  <ItemGroup>
    <!-- Show all assets in Solution Explorer -->
    <None Include="..\..\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" Visible="true" />
    <!-- Copy common assets to output -->
    <None Include="..\..\Assets\Common\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="false" IsAsset="true" />
    <None Include="..\..\Assets\Windows\**\*" Condition="'$(IsWindows)' == 'true'" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="false" IsAsset="true" />
    <None Include="..\..\Assets\Windows.$(Platform)\**\*" Condition="'$(IsWindows)' == 'true'" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="false" IsAsset="true" />
    <None Include="..\..\Assets\Linux\**\*" Condition="'$(IsLinux)' == 'true'" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="false" IsAsset="true" />
    <None Include="..\..\Assets\Linux.$(Platform)\**\*" Condition="'$(IsLinux)' == 'true'" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="false" IsAsset="true" />
  </ItemGroup>

  <Target Name="CleanOutputDirectory" BeforeTargets="BeforeBuild">
    <Message Text="Cleaning output directory: $(OutputPath)" Importance="high" />
    <RemoveDir Directories="$(OutputPath)" Condition="Exists('$(OutputPath)')" />
  </Target>

  <Target Name="CopyAssetsToBuildFolder" AfterTargets="AfterBuild">
    <ItemGroup>
      <AssetsToCopy Include="@(None)" Condition="'%(None.IsAsset)' == 'true'" />
    </ItemGroup>
    <Message Importance="High" Text="Copying Assets to: $(OutputPath)" />
    <Copy SourceFiles="@(AssetsToCopy)" DestinationFiles="$(OutputPath)%(Link)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

  <Target Name="GenerateGitVersion" BeforeTargets="BeforeCompile">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>

    <PropertyGroup>
      <GitCommitCount Condition="'$(GitCommitCount)' == '' Or $(GitCommitCount.StartsWith('fatal'))">unknown</GitCommitCount>
      <GitCommitHash Condition="'$(GitCommitHash)' == '' Or $(GitCommitHash.StartsWith('fatal'))">unknown</GitCommitHash>
      <FullVersion>3.0.0.$(GitCommitCount)</FullVersion>
      <VersionFilePath>$(IntermediateOutputPath)GeneratedVersionInfo.cs</VersionFilePath>
    </PropertyGroup>

    <ItemGroup>
      <VersionLines Include="using System.Reflection%3b" />
      <VersionLines Include="using CodeImp.DoomBuilder%3b" />
      <VersionLines Include="[assembly: AssemblyVersion(&quot;$(FullVersion)&quot;)]" />
      <VersionLines Include="[assembly: AssemblyFileVersion(&quot;$(FullVersion)&quot;)]" />
      <VersionLines Include="[assembly: AssemblyHash(&quot;$(GitCommitHash)&quot;)]" />
    </ItemGroup>

    <WriteLinesToFile File="$(VersionFilePath)" Lines="@(VersionLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(VersionFilePath)" />
    </ItemGroup>

    <Message Importance="high" Text="Got build version from Git: $(FullVersion) (saved to temporary compile-time file $(VersionFilePath))" />
  </Target>

</Project>
