<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CodeImp.DoomBuilder.Avalonia</RootNamespace>
    <AssemblyName>Builder.Avalonia</AssemblyName>
    <OutputPath>..\..\Build.Avalonia\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Diagnostics" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
  </ItemGroup>

  <!-- Reference the core Builder project for map data, rendering, etc. -->
  <ItemGroup>
    <ProjectReference Include="..\Core\Builder.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
